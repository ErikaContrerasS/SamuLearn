# Copia este archivo como .env.local y completa con los datos de tu proyecto
# de Supabase (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública del sitio (usada en el enlace de confirmación de correo).
# En desarrollo déjala así; en producción usa tu dominio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
